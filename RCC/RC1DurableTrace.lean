import RCC.RC1StepMSTBinding
import RCC.ProofCarryingTrace
import RCC.RC1TraceClosure
import RCC.RC1StepVerdictAdapter

/-!
# RC-1 durable trace realization

M1-C traces selected certified branch advances.  M1-A is the separate
instance obligation that a selected RC-1 packet has a settled representative
and append witness.  This module composes the two without pretending that the
coverage obligation is generated by the generic normalizer.

Prelude-only Lean 4.14; no Mathlib, custom axioms, or proof placeholders.
-/

namespace Residua.RCC.RC1DurableTrace

open Residua.RCC
open Residua.RCC.ProofCarryingOutcome
open Residua.RCC.ProofCarryingTrace
open Residua.RCC.RelativeCompleteClosure
open Residua.RCC.RC1StepMSTBinding
open Residua.RCC.RC1StepVerdictAdapter
open Residua.RCC.RC1TraceClosure

universe u v w x y z

/-- An instance-supplied witness that every selected RC-1 edge has a durable
Step-MST representative.  The generic normalizer does not synthesize this. -/
structure SelectedAdvanceRealizationCoverage
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    (K : RC1BranchKernel W C)
    (surface : StepSurface C) : Prop where
  cover :
    ∀ {before after : W.State}
      (edge : SelectedAdvance K.toBranchSystem before after),
      Nonempty (BoundAdvance surface edge.advance.certificate)

/-! A trace carrying the M1-A durable representative at every selected edge. -/
inductive DurableTrace
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    (K : RC1BranchKernel W C)
    (surface : StepSurface C) : W.State → W.State → Type _ where
  | nil (state : W.State) : DurableTrace K surface state state
  | cons
      {before next finish : W.State}
      (edge : SelectedAdvance K.toBranchSystem before next)
      (binding : Nonempty (BoundAdvance surface edge.advance.certificate))
      (tail : DurableTrace K surface next finish) :
      DurableTrace K surface before finish

/-- A type-safe finite path containing only the derived durable history edges. -/
inductive HistoryTrace
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    (surface : StepSurface C) : W.State → W.State → Type _ where
  | nil (state : W.State) : HistoryTrace surface state state
  | cons
      {before next finish : W.State}
      (edge : HistoryEdge surface before next)
      (tail : HistoryTrace surface next finish) :
      HistoryTrace surface before finish

namespace DurableTrace

def erase
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {start finish : W.State} :
    DurableTrace K surface start finish →
      AdmittedTrace K.toBranchSystem start finish
  | .nil state => AdmittedTrace.nil (K := K.toBranchSystem) state
  | .cons edge _ tail =>
      AdmittedTrace.cons edge (erase tail)

def realize
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    (coverage : SelectedAdvanceRealizationCoverage K surface)
    {start finish : W.State} :
    AdmittedTrace K.toBranchSystem start finish →
      DurableTrace K surface start finish
  | .nil state => DurableTrace.nil state
  | .cons edge tail =>
      DurableTrace.cons edge (coverage.cover edge) (realize coverage tail)

theorem erase_realize
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    (coverage : SelectedAdvanceRealizationCoverage K surface)
    {start finish : W.State}
    (trace : AdmittedTrace K.toBranchSystem start finish) :
    erase (realize coverage trace) = trace :=
  match trace with
  | .nil state => rfl
  | .cons edge tail =>
      congrArg (fun rest => AdmittedTrace.cons edge rest)
        (erase_realize coverage tail)

theorem erase_nonempty
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {start finish : W.State}
    (trace : Nonempty (DurableTrace K surface start finish)) :
    Nonempty (AdmittedTrace K.toBranchSystem start finish) := by
  obtain ⟨trace⟩ := trace
  exact ⟨erase trace⟩

theorem edge_history
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {before next : W.State}
    (edge : SelectedAdvance K.toBranchSystem before next)
    (binding : Nonempty (BoundAdvance surface edge.advance.certificate)) :
    HistoryEdge surface before next := by
  have historyEdge :
      HistoryEdge surface before edge.advance.next :=
    ⟨edge.advance.certificate, binding⟩
  rw [edge.targetExact] at historyEdge
  exact historyEdge

/-- Erase every realized selected edge to its exact durable history edge. -/
def toHistoryTrace
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {start finish : W.State} :
    DurableTrace K surface start finish → HistoryTrace surface start finish
  | .nil state => HistoryTrace.nil state
  | .cons edge binding tail =>
      HistoryTrace.cons (edge_history edge binding) (toHistoryTrace tail)

/-- Every realized first edge exposes the full M1-A `sigma` provenance. -/
theorem first_has_settled_sigma_provenance
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {before next : W.State}
    (edge : SelectedAdvance K.toBranchSystem before next)
    (binding : Nonempty (BoundAdvance surface edge.advance.certificate)) :
    ∃ (packet : AdvancePacket C before next)
        (event : surface.SettledEvent),
      surface.active (surface.classOf packet) = true ∧
      surface.admitted (surface.classOf packet) = true ∧
      surface.sigma (surface.classOf packet) = some event ∧
      surface.preHead event =
        (C.snapshotAt before).coordinates.historyHead ∧
      surface.settled event ∧
      surface.append before event next :=
  historyEdge_has_settled_sigma_provenance (edge_history edge binding)

/-- A durable selected edge also has a typed accepted-verdict provenance. -/
theorem selected_edge_has_accepted_verdict
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {adapter : RC1StepVerdictAdapter.Adapter C surface}
    {before next : W.State}
    (edge : SelectedAdvance K.toBranchSystem before next)
    (binding : Nonempty (BoundAdvance surface edge.advance.certificate)) :
    ∃ event,
      (RC1StepVerdictAdapter.model adapter).evalClass
          (surface.classOf edge.advance.certificate) =
        .accepted event := by
  obtain ⟨bound⟩ := binding
  exact ⟨bound.event,
    RC1StepVerdictAdapter.bound_advance_has_accepted_verdict bound⟩

/-- A finite durable trace carries a finite list of typed accepted verdicts.
The list is evidence for the trace only; it is not a new scheduler or a
claim that every open goal has a resolver. -/
inductive AcceptedVerdictTrace
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    (adapter : RC1StepVerdictAdapter.Adapter C surface) :
    {start finish : W.State} →
    DurableTrace K surface start finish →
    List surface.SettledEvent → Prop where
  | nil (state : W.State) :
      AcceptedVerdictTrace adapter (DurableTrace.nil state) []
  | cons
      {before next finish : W.State}
      {edge : SelectedAdvance K.toBranchSystem before next}
      {binding : Nonempty (BoundAdvance surface edge.advance.certificate)}
      {tail : DurableTrace K surface next finish}
      {event : surface.SettledEvent}
      (accepted :
        (RC1StepVerdictAdapter.model adapter).evalClass
            (surface.classOf edge.advance.certificate) =
          .accepted event)
      (rest : List surface.SettledEvent)
      (tailAccepted : AcceptedVerdictTrace adapter tail rest) :
      AcceptedVerdictTrace adapter
        (DurableTrace.cons edge binding tail)
        (event :: rest)

theorem accepted_verdict_trace_exists
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {adapter : RC1StepVerdictAdapter.Adapter C surface}
    {start finish : W.State}
    (trace : DurableTrace K surface start finish) :
    ∃ verdicts,
      AcceptedVerdictTrace adapter trace verdicts := by
  induction trace with
  | nil state =>
      exact ⟨[], AcceptedVerdictTrace.nil state⟩
  | @cons before next finish edge binding tail ih =>
      obtain ⟨bound⟩ := binding
      obtain ⟨verdicts, rest⟩ := ih
      exact ⟨bound.event :: verdicts,
        AcceptedVerdictTrace.cons
          (RC1StepVerdictAdapter.bound_advance_has_accepted_verdict bound)
          verdicts
          rest⟩

/-- A closed canonical normalization trace can be lifted to durable history
and then to typed accepted verdicts, provided the instance supplies the
durable representative coverage. -/
theorem normalize_closed_has_durable_accepted_trace
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {adapter : RC1StepVerdictAdapter.Adapter C surface}
    {start finish : W.State}
    (coverage : SelectedAdvanceRealizationCoverage K surface)
    (packet : GlobalEpochClosedPacket C finish)
    (normalized :
      ProofCarryingOutcome.normalize K.toBranchSystem start =
        .closed finish packet) :
    ∃ (trace : DurableTrace K surface start finish)
      (verdicts : List surface.SettledEvent),
      AcceptedVerdictTrace adapter trace verdicts := by
  have semantic :=
    rc1_normalize_closed_has_semantic_trace
      K start finish packet normalized
  obtain ⟨canonical⟩ := semantic.trace
  let trace := DurableTrace.realize coverage canonical
  obtain ⟨verdicts, accepted⟩ :=
    accepted_verdict_trace_exists (adapter := adapter) trace
  exact ⟨trace, verdicts, accepted⟩

def durable_trace_has_selected_trace
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    {start finish : W.State}
    (trace : DurableTrace K surface start finish) :
    AdmittedTrace K.toBranchSystem start finish :=
  erase trace

end DurableTrace

/-! CoreObject transitions now commute with the durable realization layer. -/
theorem rc1_core_transition_iff_durable_trace_and_closed
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    (execution : RC1Execution K)
    (surface : StepSurface C)
    (coverage : SelectedAdvanceRealizationCoverage K surface)
    {start finish : W.State} :
    (ProofCarryingOutcome.coreObject K.toBranchSystem).D start finish ↔
      (Nonempty (DurableTrace K surface start finish) ∧
        GlobalEpochClosed C finish) := by
  constructor
  · intro transition
    have selected := (rc1_core_transition_iff_trace_and_closed execution).mp transition
    obtain ⟨trace⟩ := selected.1
    exact ⟨⟨DurableTrace.realize coverage trace⟩, selected.2⟩
  · rintro ⟨durable, closed⟩
    exact (rc1_core_transition_iff_trace_and_closed execution).mpr
      ⟨DurableTrace.erase_nonempty durable, closed⟩

/-!
The verdict-bearing form is the final M1-E seam: a `CoreObject.D` edge is
equivalent to one durable selected trace whose every edge exposes the typed
accepted verdict consumed by the same `Step-MST` adapter.  The verdict list is
derived evidence, not a second scheduler or an independent history source.
-/
theorem rc1_core_transition_iff_durable_accepted_trace_and_closed
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    (execution : RC1Execution K)
    (surface : StepSurface C)
    (coverage : SelectedAdvanceRealizationCoverage K surface)
    {adapter : RC1StepVerdictAdapter.Adapter C surface}
    {start finish : W.State} :
    (ProofCarryingOutcome.coreObject K.toBranchSystem).D start finish ↔
      ∃ (trace : DurableTrace K surface start finish)
        (verdicts : List surface.SettledEvent),
        Nonempty (DurableTrace.AcceptedVerdictTrace adapter trace verdicts) ∧
          GlobalEpochClosed C finish := by
  constructor
  · intro transition
    have durableClosed :=
      (rc1_core_transition_iff_durable_trace_and_closed
        execution surface coverage).mp transition
    obtain ⟨trace⟩ := durableClosed.1
    obtain ⟨verdicts, accepted⟩ :=
      DurableTrace.accepted_verdict_trace_exists
        (adapter := adapter) trace
    exact ⟨trace, verdicts, ⟨accepted⟩, durableClosed.2⟩
  · rintro ⟨trace, verdicts, accepted, closed⟩
    have durable : Nonempty (DurableTrace K surface start finish) :=
      ⟨trace⟩
    exact
      (rc1_core_transition_iff_durable_trace_and_closed
        execution surface coverage).mpr ⟨durable, closed⟩

/-- The durable/verdict bridge at a fixed point, suitable for the RC-1
`Fix = Adm` instantiation, retains the same accepted trace evidence. -/
theorem rc1_core_fixed_iff_durable_accepted_trace_and_closed
    {W : WakeSystem.{u, v, w, x, y, z}}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    (execution : RC1Execution K)
    (surface : StepSurface C)
    (coverage : SelectedAdvanceRealizationCoverage K surface)
    {adapter : RC1StepVerdictAdapter.Adapter C surface}
    {state : W.State} :
    (ProofCarryingOutcome.coreObject K.toBranchSystem).D state state ↔
      ∃ (trace : DurableTrace K surface state state)
        (verdicts : List surface.SettledEvent),
        Nonempty (DurableTrace.AcceptedVerdictTrace adapter trace verdicts) ∧
          GlobalEpochClosed C state := by
  exact
    rc1_core_transition_iff_durable_accepted_trace_and_closed
      execution surface coverage

/--
An empty settled-event carrier cannot cover even one actual selected edge.
Thus generic closure does not manufacture durable event realization.
-/
theorem empty_settled_event_cannot_cover_selected_edge
    {W : WakeSystem}
    {C : ClosureContext W.State}
    {K : RC1BranchKernel W C}
    {surface : StepSurface C}
    (empty : surface.SettledEvent → False)
    {before after : W.State}
    (edge : SelectedAdvance K.toBranchSystem before after) :
    ¬ SelectedAdvanceRealizationCoverage K surface := by
  intro coverage
  obtain ⟨binding⟩ := coverage.cover edge
  exact empty binding.event

end Residua.RCC.RC1DurableTrace
